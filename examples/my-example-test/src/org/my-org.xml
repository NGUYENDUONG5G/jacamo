<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="https://moise-lang.github.io/xml/os.xsl" type="text/xsl" ?>

<organisational-specification
    id="delivery_org"
    os-version="1.1"
    xmlns='http://moise.sourceforge.net/os'
    xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
    xsi:schemaLocation='http://moise.sourceforge.net/os
                        https://moise-lang.github.io/xml/os.xsd' >

    <structural-specification>
        <role-definitions>
            <role id="dispatcher" />
            <role id="delivery_robot" />
        </role-definitions>

        <group-specification id="team">
            <roles>
                <role id="dispatcher" min="1" max="1" />
                <role id="delivery_robot" min="1" max="10" />
            </roles>
            <formation-constraints>
                <compatibility from="dispatcher" to="delivery_robot" scope="intra-group" bi-dir="true"/>
            </formation-constraints>
        </group-specification>
    </structural-specification>

    <functional-specification>
        <scheme id="delivery_scheme">
            <goal id="deliver_success">
                <plan operator="sequence">
                    <goal id="pickup_package" />
                    <goal id="transit_to_delivery" />
                    <goal id="handover_package" />
                    <goal id="complete_cycle" />
                </plan>
            </goal>

            <mission id="delivery_mission" min="1" max="10">
                <goal id="deliver_success" />
                <goal id="pickup_package" />
                <goal id="transit_to_delivery" />
                <goal id="handover_package" />
                <goal id="complete_cycle" />
            </mission>
        </scheme>
    </functional-specification>

    <normative-specification>
        <!-- Tạm tắt obligation tự động để tác tử ở trạng thái chờ kích hoạt / inject belief từ Web -->
        <!-- <norm id="n1" type="obligation" role="delivery_robot" mission="delivery_mission" /> -->
    </normative-specification>

</organisational-specification>
