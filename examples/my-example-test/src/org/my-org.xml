<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="https://moise-lang.github.io/xml/os.xsl" type="text/xsl" ?>

<organisational-specification
    id="delivery_org"
    os-version="1.1"
    xmlns='http://moise.sourceforge.net/os'
    xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
    xsi:schemaLocation='http://moise.sourceforge.net/os
                        https://moise-lang.github.io/xml/os.xsd' >

    <structural-specification>
        <role-definitions>
            <role id="dispatcher" />
            <role id="truck" />
        </role-definitions>

        <group-specification id="team">
            <roles>
                <role id="dispatcher" min="1" max="1" />
                <role id="truck" min="1" max="10" />
            </roles>
            <formation-constraints>
                <compatibility from="dispatcher" to="truck" scope="intra-group" bi-dir="true"/>
            </formation-constraints>
        </group-specification>
    </structural-specification>

    <functional-specification>
        <scheme id="delivery_scheme">
            <goal id="deliver_package">
                <plan operator="sequence">
                    <goal id="plan_route" />
                    <goal id="deliver_on_time" />
                </plan>
            </goal>

            <mission id="dispatch_mission" min="1" max="1">
                <goal id="plan_route" />
            </mission>
            
            <mission id="delivery_mission" min="1" max="10">
                <goal id="deliver_on_time" />
            </mission>
        </scheme>
    </functional-specification>

    <normative-specification>
        <norm id="n1" type="obligation" role="dispatcher" mission="dispatch_mission" />
        <norm id="n2" type="obligation" role="truck" mission="delivery_mission" />
    </normative-specification>

</organisational-specification>
