mas my_example {

    agent delivery_truck : delivery_truck/delivery_truck.asl {
        ag-class: jacamo.platform.ExtendedAgent
        join: w1
        focus: w1.navigation
    }

    workspace w1 {
        artifact navigation : tools.DeliverySystem("warehouse_dock_A")
    }

    organisation o1 : src/org/my-org.xml {
        group my_team : team {
            responsible-for: s1
        }
        scheme s1 : delivery_scheme {
        }
    }

    failure pickup_package {
        error robot_arm_error {
            conditions: arm_disconnected
            recovery-activities: "goal:cancel_and_log_wms"
        }
        error invalid_barcode {
            conditions: barcode_invalid
            recovery-activities: "goal:cancel_and_log_wms"
        }
        error overweight {
            conditions: package_overweight
            recovery-activities: "goal:cancel_and_log_wms"
        }
    }

  
    failure transit_to_delivery {
        error road_blocked {
            conditions: path_blocked
            recovery-activities: "goal:reroute_new_path", "env:w1.navigation.reroute"
        }
        error sensor_failure {
            conditions: gps_lost
            recovery-activities: "goal:emergency_rescue", "env:w1.navigation.emergency_brake"
        }
        error low_battery {
            conditions: battery_critical
            recovery-activities: "goal:emergency_rescue", "env:w1.navigation.emergency_brake"
        }
    }

  
    failure handover_package {
        error customer_timeout {
            conditions: wait_timeout
            recovery-activities: "goal:return_to_warehouse", "env:w1.navigation.lock_cargo"
        }
        error auth_failed_limit {
            conditions: auth_exceeded
            recovery-activities: "goal:return_to_warehouse", "env:w1.navigation.lock_cargo"
        }
        error lock_jammed {
            conditions: hatch_jammed
            recovery-activities: "goal:return_to_warehouse", "env:w1.navigation.lock_cargo"
        }
    }

    
    failure complete_cycle {
        error dock_unavailable {
            conditions: docks_occupied
            recovery-activities: "goal:standby_sleep_mode"
        }
        error contact_misaligned {
            conditions: dock_misaligned
            recovery-activities: "goal:standby_sleep_mode"
        }
    }

    class-path: bin/classes
}
