mas my_example {

    // ========================================================================
    // 1. TÁC TỬ (AGENTS)
    // ========================================================================
    
    // Tác tử điều phối viên kho vận (Dispatcher)
    agent dispatcher : dispatcher/dispatcher.asl {
        join: w1
        failure: dispatcher_coordination
    }

    // Tác tử xe tải giao hàng tự hành (Delivery Truck)
    agent delivery_truck : delivery_truck/delivery_truck.asl {
        join: w1
        focus: w1.navigation
        failure: pickup_package, transit_to_delivery, handover_package, complete_cycle
    }

    // ========================================================================
    // 2. MÔI TRƯỜNG & KHÔNG GIAN LÀM VIỆC (WORKSPACE)
    // ========================================================================
    workspace w1 {
        artifact navigation : tools.DeliverySystem("warehouse_dock_A")
    }

    // ========================================================================
    // 3. TỔ CHỨC MOISE (ORGANISATION)
    // ========================================================================
    organisation o1 : src/org/my-org.xml {
        group my_team : team {
            responsible-for: s1
            players: dispatcher     dispatcher
                     delivery_truck delivery_robot
            failure: dispatcher_coordination
        }

        scheme s1 : delivery_scheme {
            failure: delivery_scheme_execution
        }
    }

    // ========================================================================
    // 4. ĐẶC TẢ FAILURE MODEL CHO TỔ CHỨC (ORGANISATION FAILURES)
    // ========================================================================
    
    // Giám sát phối hợp tổ chức trong nhóm giao hàng
    failure dispatcher_coordination {
        error missing_dispatcher {
            conditions: "cardinality(dispatcher) < 1"
            recovery-activities: "org:my_team.adoptRole(dispatcher)", 
                                "goal:notify_fleet_manager"
        }
        error fleet_overloaded {
            conditions: "cardinality(delivery_robot) > 8"
            recovery-activities: "goal:reassign_urgent_deliveries"
        }
    }

    // Giám sát tiến độ thực thi đồ hình kế hoạch chung (Scheme)
    failure delivery_scheme_execution {
        error scheme_timeout {
            conditions: scheme_deadlock
            recovery-activities: "org:s1.substitute_scheme(emergency_delivery_scheme)", 
                                "env:w1.navigation.reroute"
        }
    }

    // ========================================================================
    // 5. ĐẶC TẢ FAILURE MODEL CHO TÁC TỬ (AGENT & ENVIRONMENT FAILURES)
    // ========================================================================
    
    // [G1] Lấy hàng tại kho
    failure pickup_package {
        error robot_arm_error {
            conditions: arm_disconnected
            recovery-activities: "goal:cancel_and_log_wms"
        }
        error invalid_barcode {
            conditions: barcode_invalid
            recovery-activities: "goal:cancel_and_log_wms"
        }
        error overweight {
            conditions: package_overweight
            recovery-activities: "goal:cancel_and_log_wms"
        }
    }

    // [G2] Di chuyển và điều hướng giao hàng
    failure transit_to_delivery {
        error road_blocked {
            conditions: path_blocked
            recovery-activities: "goal:reroute_new_path", "env:w1.navigation.reroute"
        }
        error sensor_failure {
            conditions: gps_lost
            recovery-activities: "goal:emergency_rescue", "env:w1.navigation.emergency_brake"
        }
        error low_battery {
            conditions: battery_critical
            recovery-activities: "goal:emergency_rescue", "env:w1.navigation.emergency_brake"
        }
    }

    // [G3] Bàn giao kiện hàng cho khách
    failure handover_package {
        error customer_timeout {
            conditions: wait_timeout
            recovery-activities: "goal:return_to_warehouse", "env:w1.navigation.lock_cargo"
        }
        error auth_failed_limit {
            conditions: auth_exceeded
            recovery-activities: "goal:return_to_warehouse", "env:w1.navigation.lock_cargo"
        }
        error lock_jammed {
            conditions: hatch_jammed
            recovery-activities: "goal:return_to_warehouse", "env:w1.navigation.lock_cargo"
        }
    }

    // [G4] Hoàn tất chu trình quay về trạm sạc
    failure complete_cycle {
        error dock_unavailable {
            conditions: docks_occupied
            recovery-activities: "goal:standby_sleep_mode"
        }
        error contact_misaligned {
            conditions: dock_misaligned
            recovery-activities: "goal:standby_sleep_mode"
        }
    }

    class-path: bin/classes
}
