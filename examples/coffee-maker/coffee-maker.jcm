mas coffee_maker_mas {

    // ========================================================================
    // 1. TÁC TỬ (AGENTS)
    // ========================================================================
    
    // Tác tử Máy xay & Chuẩn bị Cà phê (Coffee Grinder)
    agent coffee_grinder : coffee_grinder/coffee_grinder.asl {
        join: w1
        focus: w1.coffee_system
        failure: grind_beans
    }

    // Tác tử Máy đun nước nóng thông minh (Water Boiler)
    agent water_boiler : water_boiler/water_boiler.asl {
        join: w1
        focus: w1.water_system
        failure: boil_water
    }

    // ========================================================================
    // 2. MÔI TRƯỜNG & KHÔNG GIAN LÀM VIỆC (WORKSPACE)
    // ========================================================================
    workspace w1 {
        artifact coffee_system : tools.CoffeeMachineArtifact(11)
        artifact water_system  : tools.WaterBoilerArtifact(1000, 25)
    }

    // ========================================================================
    // 3. TỔ CHỨC MOISE (ORGANISATION)
    // ========================================================================
    organisation o1 : src/org/coffee-org.xml {
        group my_coffee_team : coffee_team {
            responsible-for: s1
            players: coffee_grinder coffee_maker_role
                     water_boiler  water_boiler_role
            failure: coffee_team_coordination
        }

        scheme s1 : coffee_scheme {
            failure: coffee_scheme_execution
        }
    }

    // ========================================================================
    // 4. ĐẶC TẢ FAILURE MODEL CHO TỔ CHỨC (ORGANISATION FAILURES)
    // ========================================================================
    
    // Giám sát phối hợp tổ chức trong nhóm pha chế
    failure coffee_team_coordination {
        error missing_boiler_agent {
            conditions: "cardinality(water_boiler_role) < 1"
            recovery-activities: "org:my_coffee_team.adoptRole(water_boiler_role)", 
                                "goal:notify_maintenance"
        }
        error missing_brewer_agent {
            conditions: "cardinality(coffee_maker_role) < 1"
            recovery-activities: "org:my_coffee_team.adoptRole(coffee_maker_role)", 
                                "goal:notify_maintenance"
        }
    }

    // Giám sát tiến độ thực thi Scheme đồ hình pha chế
    failure coffee_scheme_execution {
        error scheme_deadlock {
            conditions: scheme_deadlock
            recovery-activities: "org:s1.substitute_scheme(emergency_coffee_scheme)", 
                                "goal:reset_simulation"
        }
        error brewing_timeout {
            conditions: brewing_timeout
            recovery-activities: "goal:abort_and_clean_up", 
                                "env:w1.coffee_system.cancel_operation"
        }
    }

    // ========================================================================
    // 5. ĐẶC TẢ FAILURE MODEL CHO TÁC TỬ (AGENT & GOAL FAILURES)
    // ========================================================================

    // Giám sát mục tiêu xay hạt cà phê [grind_beans] của tác tử coffee_grinder
    failure grind_beans {
        error no_beans {
            conditions: beans_depleted
            recovery-activities: "goal:ensure_required_bean_amount", 
                                "env:w1.coffee_system.refill_beans(200)"
        }
        error grinder_jammed {
            conditions: grinder_overload
            recovery-activities: "goal:unclog_grinder", 
                                "env:w1.coffee_system.reset_grinder"
        }
    }

    // Giám sát mục tiêu đun nước sôi [boil_water] của tác tử water_boiler
    failure boil_water {
        error insufficient_supply_water {
            conditions: supply_water_insufficient
            recovery-activities: "goal:ensure_sufficient_water_volume", 
                                "env:w1.water_system.refill_supply_tank(1000)"
        }
        error heater_overheated {
            conditions: water_overheated
            recovery-activities: "goal:cooldown_boiler", 
                                "env:w1.water_system.cool_down"
        }
    }
}
