mas iCleaner_MAS {

    agent icleaner : icleaner/icleaner.asl {
        ag-class: jacamo.platform.ExtendedAgent
        join: w1
        focus: w1.battery, w1.charging_station, w1.dustbin, w1.room
    }

    workspace w1 {
        artifact battery          : tools.BatteryArtifact(100)
        artifact charging_station : tools.ChargingStation("dock_station_A")
        artifact dustbin          : tools.DustbinArtifact("external_dustbin_1")
        artifact room             : tools.RoomEnvironment("living_room_1")
    }

    organisation o1 : src/org/my-org.xml {
        group cleaner_team : team {
            responsible-for: s1
        }
        scheme s1 : cleaning_scheme {
        }
    }

    failure battery_loaded {
        error charging_station_too_distant {
            conditions: station_too_distant
            recovery-activities: "goal:emergency_move", 
                                "goal:send_rescue_signal", 
                                "env:w1.charging_station.call_support"
        }
    }

    class-path: bin/classes
}
